# ── Site ────────────────────────────────────────────────
SITE_NAME="Luís Cunha Photos"
# URL público (usado em emails, links de pagamento e SEO)
SITE_URL="http://localhost:3000"
# Texto da marca de água nas pré-visualizações
# Só usado enquanto não houver logótipo carregado no admin
WATERMARK_TEXT="© Luís Cunha Photos"
CONTACT_EMAIL="geral@exemplo.pt"

# ── Administração ───────────────────────────────────────
ADMIN_PASSWORD="muda-esta-password"
# String aleatória longa (ex.: openssl rand -hex 32)
SESSION_SECRET="troca-isto-por-uma-string-aleatoria-longa"

# ── Pagamentos (Stripe: cartão, MB Way, Multibanco) ─────
# Sem STRIPE_SECRET_KEY o site usa pagamentos de demonstração (só fora de produção).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Permitir pagamentos de demonstração em produção (NUNCA em modo real)
ALLOW_DEMO_PAYMENTS="false"

# ── Email (SMTP) ────────────────────────────────────────
# Sem SMTP_HOST os emails são apenas escritos na consola.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Luís Cunha Photos <fotos@exemplo.pt>"

# ── Armazenamento ───────────────────────────────────────
# Pasta com a base de dados e as fotografias (tem de ser persistente)
DATA_DIR="./data"
# Dias durante os quais o link de download é válido
DOWNLOAD_DAYS="30"
